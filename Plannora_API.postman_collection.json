    {
      "name": "4. Requests (Customer)",
      "item": [
        {
          "name": "4.1 Create Request",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "if (pm.response.code === 201) {",
                  "    var data = pm.response.json();",
                  "    if (data.request && data.request._id) {",
                  "        pm.collectionVariables.set('requestId', data.request._id);",
                  "        console.log('requestId saved to collection variables: ' + data.request._id);",
                  "    }",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Authorization", "value": "Bearer {{jwt_token}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"event_details\": \"Corporate Summit 2026\",\n  \"pay\": 3000,\n  \"city\": \"Mumbai\",\n  \"state\": \"Maharashtra\",\n  \"pincode\": \"400001\",\n  \"location\": \"Grand Hyatt Mumbai\",\n  \"category\": \"Professional\",\n  \"time\": \"10:00 AM - 06:00 PM\",\n  \"start_time\": \"2026-11-20T10:00:00.000Z\",\n  \"end_time\": \"2026-11-20T18:00:00.000Z\",\n  \"date\": \"2026-11-20T00:00:00.000Z\",\n  \"no_of_candidates\": 2,\n  \"additional_description\": \"Need registration desk support and guest reception\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/request/create",
              "host": ["{{baseUrl}}"],
              "path": ["api", "request", "create"]
            }
          }
        },
